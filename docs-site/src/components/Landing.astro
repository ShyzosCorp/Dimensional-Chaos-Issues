const guideImages = [gateway, oneblock, expedition, expansion];
const smallIcons = [iGateway, iReturn, iCompass];
const realmImages = [rTf, rAe, rNether, rUg, rMining, rEnd, rOther, rOtherside];
const realmTiers = [0, 1, 2, 4, 5, 6, 6, 7];
const itemImages = [iGateway, iReturn, iFracture, iFragment, iCompass];
---

<div class="dc-landing not-content">
  <section class="dc-hero2">
    <div class="dc-hero2-copy">
      <p class="dc-pixel-chip"><span class="dc-eyebrow-dot" aria-hidden="true"></span>{T.eyebrow}</p>
      <p class="dc-wordmark" aria-hidden="true"><span>Dimensional</span> <span>Chaos</span></p>
      <p class="dc-wordmark-sub" aria-hidden="true">OneBlock</p>
      <p class="dc-hero2-tagline">{T.tagline}</p>
      <div class="dc-actions">
        <a class="dc-btn dc-btn--primary" href="./getting-started/">{T.start}<span aria-hidden="true">→</span></a>
        <a class="dc-btn dc-btn--ghost" href="./installation/">{T.install}</a>
      </div>
      <ul class="dc-meta">{T.meta.map((m) => <li>{m}</li>)}</ul>
    </div>
    <div class="dc-hero2-art" aria-hidden="true">
      <div class="dc-hero2-glow"></div>
      <Image class="dc-hero2-island" src={island} alt="" widths={[450, 900]} sizes="(min-width: 60rem) 30rem, 80vw" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <ul class="dc-stats">
    {T.stats.map(([n, label]) => (
      <li><span class="dc-stat-n">{n}</span><span class="dc-stat-l">{label}</span></li>
    ))}
  </ul>

  <section class="dc-section">
    <header class="dc-section-head">
      <p class="dc-pixel">{T.guidesEyebrow}</p>
      <h2>{T.guidesTitle}</h2>
    </header>
    <div class="dc-cards">
      {T.guides.map(([slug, title, text], i) => (
        <a class="dc-card" href={`./${slug}/`}>
          <Image src={guideImages[i]} alt="" widths={[400, 800]} sizes="(min-width: 72rem) 18rem, (min-width: 40rem) 45vw, 100vw" />
          <span class="dc-card-body"><strong>{title}</strong><span>{text}</span></span>
        </a>
      ))}
    </div>
    <div class="dc-minis">
      {T.small.map(([slug, title, text], i) => (
        <a class="dc-mini" href={`./${slug}/`}>
          <Image src={smallIcons[i]} alt="" width={56} height={56} />
          <span><strong>{title}</strong><span>{text}</span></span>
          <span class="dc-mini-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="dc-section">
    <header class="dc-section-head">
      <p class="dc-pixel">{T.realmsEyebrow}</p>
      <h2>{T.realmsTitle}</h2>
      <p>{T.realmsText}</p>
    </header>
    <ul class="dc-realms">
      {T.realms.map((name, i) => (
        <li class="dc-realm">
          <Image src={realmImages[i]} alt="" widths={[400, 800]} sizes="(min-width: 72rem) 18rem, (min-width: 40rem) 45vw, 100vw" />
          <span class="dc-realm-label"><strong>{name}</strong><span class="dc-tier">{T.tier} {realmTiers[i]}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="dc-section">
    <header class="dc-section-head">
      <p class="dc-pixel">{T.itemsEyebrow}</p>
      <h2>{T.itemsTitle}</h2>
    </header>
    <ul class="dc-items">
      {T.items.map(([name, text], i) => (
        <li class="dc-item">
          <span class="dc-item-icon"><Image src={itemImages[i]} alt="" width={96} height={96} /></span>
          <strong>{name}</strong>
          <span>{text}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="dc-server">
    <div class="dc-server-copy">
      <p class="dc-pixel">{T.serverEyebrow}</p>
      <h2>{T.serverTitle}</h2>
      <p>{T.serverText}</p>
      <div class="dc-address">
        <code>{SERVER}</code>
        <button type="button" class="dc-copy" data-copy={SERVER} data-done={T.copied}>{T.copy}</button>
      </div>
    </div>
    <div class="dc-server-links">
      <a class="dc-btn dc-btn--cf" href={MOD}>{T.links[0]}</a>
      <a class="dc-btn dc-btn--cf" href={PACK}>{T.links[1]}</a>
      <a class="dc-btn dc-btn--ghost" href={BUG}>{T.links[2]}</a>
    </div>
  </section>

  <p class="dc-about">{T.about}</p>
  <p class="dc-note">{T.note}</p>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.dc-copy')) {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = button.dataset.done ?? label;
        button.classList.add('is-done');
        setTimeout(() => { button.textContent = label; button.classList.remove('is-done'); }, 1800);
      } catch {
        const code = button.previousElementSibling;
        if (code) getSelection()?.selectAllChildren(code);
      }
    });
  }
</script>
